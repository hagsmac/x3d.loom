{
  "schema": "loom.hep-event-spec/1",
  "note": "Demo plausibility spec. Every number is a declared, loose threshold for a viewer, not a precision study; change it here, never in kit/loomkit/hepevent.py.",
  "units": {"length_range_m": [0.05, 50.0], "ratio_log10_tol": 0.3},
  "p4": {"abs_tol_gev": 0.5, "rel_tol": 0.0001},
  "charge": {"abs_tol": 0.000001},
  "curvature": {"rel_tol": 0.15, "abs_tol_per_m": 0.01, "straight_sagitta_m": 0.002, "point_resolution_m": 0.0001, "resolvable_sagitta_m": 0.0003},
  "containment": {"margin_m": 0.02},
  "scene": {
    "required": true,
    "unreadable_nodes": "reject",
    "draw_eta_max": 10.0,
    "draw_min_pt_gev": 0.15,
    "draw_min_neutral_e_gev": 0.3,
    "invisible_pdg": [12, 14, 16],
    "min_points": 2,
    "shader": {
      "time_field": "u_phase",
      "pt_rel_tol": 0.01,
      "ident": {"name": "a_ident", "layout": ["id", "charge", "pt", "birth_s"]},
      "attributes": [
        {"name": "a_ident", "components": 4},
        {"name": "a_arc", "components": 1, "constant": false},
        {"name": "a_species", "components": 1}
      ]
    },
    "merged": {
      "note": "Look v2: tracks as ribbons in a few merged strips, muon extensions, tower spikes. The builder's anti-degeneracy offset, declared here so the witness can take it off.",
      "offset_m": [0.004, 0.0028, 0.0012],
      "offset_tol_m": 0.0002,
      "tower_cell": {"name": "a_cell", "layout": ["id", "E", "em_frac", "arrival_s"], "e_rel_tol": 0.01},
      "extensions": {"pdg": [13], "r_max_m": 3.4, "half_length_m": 4.5, "join_tol_m": 0.01}
    }
  }
}
