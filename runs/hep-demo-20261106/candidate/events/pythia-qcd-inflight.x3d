<ComposedShader DEF='trkShader' language='GLSL'><field name='u_phase' type='SFFloat' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX' url='"data:x-shader/x-vertex,precision highp float; uniform mat4 x3d_ModelViewMatrix; uniform mat4 x3d_ProjectionMatrix; attribute vec4 x3d_Vertex; attribute vec4 a_ident; attribute float a_arc; attribute float a_species; varying vec4 v_ident; varying float v_arc; varying float v_species; void main() { v_ident = a_ident; v_arc = a_arc; v_species = a_species; gl_Position = x3d_ProjectionMatrix * x3d_ModelViewMatrix * x3d_Vertex; }"'/><ShaderPart type='FRAGMENT' url='"data:x-shader/x-fragment,precision highp float; uniform float u_phase; varying vec4 v_ident; varying float v_arc; varying float v_species; vec3 species_color(float sp, float q) { vec3 c = vec3(0.35, 0.85, 1.0); if (q &lt; 0.0) { c = vec3(1.0, 0.30, 0.85); } if (sp &gt; 3.5 &amp;&amp; sp &lt; 4.5) { c = vec3(1.0, 0.65, 0.15); } if (sp &gt; 0.5 &amp;&amp; sp &lt; 1.5) { c = vec3(0.20, 1.0, 0.50); } if (sp &gt; 1.5 &amp;&amp; sp &lt; 2.5) { c = vec3(0.65, 0.45, 1.0); } if (sp &gt; 4.5 &amp;&amp; sp &lt; 5.5) { c = vec3(1.0, 0.92, 0.55); } if (sp &gt; 5.5) { c = vec3(0.95, 0.60, 0.30); } return c; } void main() { float t = u_phase * 12.0; float birth = v_ident.w; float head = (t - 0.5 - birth) * 0.9; if (v_arc &gt; head) { discard; } float bright = clamp(log(1.0 + v_ident.z) / log(61.0), 0.0, 1.0); vec3 c = species_color(v_species, v_ident.y); float w = fract(v_arc * 2.2 - (t - birth) * 0.9); float pulse = pow(w, 5.0); float tip = exp(-(head - v_arc) * 14.0); float fade = smoothstep(0.0, 0.5, t) * (1.0 - smoothstep(10.4, 11.9, t)); float gain = (0.35 + 0.9 * bright) * (0.55 + 1.1 * pulse) + 1.6 * tip; vec3 col = mix(c, vec3(1.0), clamp(tip * 0.9 + 0.25 * bright * pulse, 0.0, 1.0)) * gain; gl_FragColor = vec4(col * fade, 1.0); }"'/></ComposedShader>
<ComposedShader DEF='twrShader' language='GLSL'><field name='u_phase' type='SFFloat' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX' url='"data:x-shader/x-vertex,precision highp float; uniform mat4 x3d_ModelViewMatrix; uniform mat4 x3d_ProjectionMatrix; attribute vec4 x3d_Vertex; uniform float u_phase; attribute vec4 a_tower; attribute vec3 a_base; varying vec4 v_tower; void main() { float t = u_phase * 12.0; float k = smoothstep(a_tower.y, a_tower.y + 0.45, t); vec3 p = mix(a_base, x3d_Vertex.xyz, k * a_tower.w + (1.0 - a_tower.w)); v_tower = a_tower; gl_Position = x3d_ProjectionMatrix * x3d_ModelViewMatrix * vec4(p, 1.0); }"'/><ShaderPart type='FRAGMENT' url='"data:x-shader/x-fragment,precision highp float; uniform float u_phase; varying vec4 v_tower; void main() { float t = u_phase * 12.0; vec3 c = mix(vec3(0.25, 0.62, 1.0), vec3(1.0, 0.56, 0.12), step(0.5, v_tower.z)); float lit = smoothstep(v_tower.y, v_tower.y + 0.2, t); float flare = exp(-max(t - v_tower.y, 0.0) * 2.5) * lit; float e = clamp(log(1.0 + v_tower.x) / log(41.0), 0.0, 1.0); float fade = smoothstep(0.0, 0.5, t) * (1.0 - smoothstep(10.4, 11.9, t)); float tip = mix(0.55, 1.0, v_tower.w); vec3 col = c * (0.08 + lit * (0.45 + 0.9 * e) * tip) + vec3(1.0) * flare * 0.5; gl_FragColor = vec4(col * fade, 1.0); }"'/></ComposedShader>
<ComposedShader DEF='ringShader' language='GLSL'><field name='u_phase' type='SFFloat' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX' url='"data:x-shader/x-vertex,precision highp float; uniform mat4 x3d_ModelViewMatrix; uniform mat4 x3d_ProjectionMatrix; attribute vec4 x3d_Vertex; attribute vec3 a_ring; varying vec3 v_ring; void main() { v_ring = a_ring; gl_Position = x3d_ProjectionMatrix * x3d_ModelViewMatrix * x3d_Vertex; }"'/><ShaderPart type='FRAGMENT' url='"data:x-shader/x-fragment,precision highp float; uniform float u_phase; varying vec3 v_ring; void main() { float t = u_phase * 12.0; float front = (t - 0.5) * 3.0; float d = (front - v_ring.x) * 5.0; float ripple = exp(-d * d) * step(0.0, t - 0.5); float shimmer = 0.5 + 0.5 * sin(v_ring.y * 62.8318 - t * 1.3); vec3 c = mix(vec3(0.10, 0.30, 0.65), vec3(0.55, 0.85, 1.0), v_ring.z); vec3 col = c * (0.35 + 0.45 * shimmer * v_ring.z) + vec3(0.6, 0.85, 1.0) * ripple * 1.2; gl_FragColor = vec4(col, 1.0); }"'/></ComposedShader>
<ComposedShader DEF='flashShader' language='GLSL'><field name='u_phase' type='SFFloat' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX' url='"data:x-shader/x-vertex,precision highp float; uniform mat4 x3d_ModelViewMatrix; uniform mat4 x3d_ProjectionMatrix; attribute vec4 x3d_Vertex; uniform float u_phase; varying float v_flash; void main() { float t = u_phase * 12.0; float s = t - 0.5; v_flash = exp(-max(s, 0.0) * 2.2) * step(0.0, s); gl_PointSize = 26.0 + 330.0 * v_flash; gl_Position = x3d_ProjectionMatrix * x3d_ModelViewMatrix * x3d_Vertex; }"'/><ShaderPart type='FRAGMENT' url='"data:x-shader/x-fragment,precision highp float; varying float v_flash; void main() { vec2 q = (gl_PointCoord - vec2(0.5)) * 2.0; float d = length(q); if (d &gt; 1.0) { discard; } float core = exp(-d * d * 18.0); float halo = exp(-d * 3.5) * (0.15 + 0.85 * v_flash) * (1.0 - d); float spikes = (exp(-abs(q.x) * 30.0) + exp(-abs(q.y) * 30.0)) * (1.0 - d) * v_flash * 0.8; float a = core * (0.6 + 0.8 * v_flash) + halo + spikes; if (a &lt; 0.03) { discard; } vec3 col = mix(vec3(0.35, 0.65, 1.0), vec3(1.0), clamp(core + v_flash * 0.5, 0.0, 1.0)) * a; gl_FragColor = vec4(col, 1.0); }"'/></ComposedShader>
