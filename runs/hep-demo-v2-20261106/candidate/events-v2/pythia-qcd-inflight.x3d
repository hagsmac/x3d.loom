<ComposedShader DEF='trkShader2' language='GLSL'><field name='u_phase' type='SFFloat' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX' url='"data:x-shader/x-vertex,precision highp float; uniform mat4 x3d_ModelViewMatrix; uniform mat4 x3d_ProjectionMatrix; attribute vec4 x3d_Vertex; uniform ivec4 x3d_Viewport; uniform float u_phase; attribute vec4 a_ident; attribute float a_arc; attribute float a_species; attribute vec3 a_next; attribute vec4 a_look; varying vec4 v_ident; varying float v_arc; varying float v_species; varying vec4 v_look; varying float v_rad; void main() { vec3 c = x3d_Vertex.xyz - a_look.x * vec3(0.004, 0.0028, 0.0012); vec4 c0 = x3d_ProjectionMatrix * (x3d_ModelViewMatrix * vec4(c, 1.0)); vec4 c1 = x3d_ProjectionMatrix * (x3d_ModelViewMatrix * vec4(a_next, 1.0)); vec2 hv = vec2(x3d_Viewport.zw) * 0.5; vec2 d = (c1.xy / c1.w - c0.xy / c0.w) * hv; float l = length(d); d = l &gt; 0.0001 ? d / l : vec2(1.0, 0.0); float bright = clamp(log(1.0 + a_ident.z) / log(41.0), 0.0, 1.0); float mu = step(1.5, a_species) * (1.0 - step(2.5, a_species)); float w = 1.0 + 3.2 * pow(bright, 1.3) + 1.6 * mu; vec2 o = vec2(-d.y, d.x) * a_look.x * w; gl_Position = c0 + vec4(o / hv * c0.w, 0.0, 0.0); v_ident = a_ident; v_arc = a_arc; v_species = a_species; v_look = a_look; v_rad = length(c.xy); }"'/><ShaderPart type='FRAGMENT' url='"data:x-shader/x-fragment,precision highp float; uniform float u_phase; varying vec4 v_ident; varying float v_arc; varying float v_species; varying vec4 v_look; varying float v_rad; float hash(float n) { return fract(sin(n * 91.3458) * 47453.5453); } vec3 hue(float sp, float q) { vec3 c = vec3(0.10, 0.92, 1.0); if (q &lt; 0.0) { c = vec3(1.0, 0.14, 0.72); } if (sp &gt; 0.5 &amp;&amp; sp &lt; 1.5) { c = vec3(0.14, 1.0, 0.40); } if (sp &gt; 1.5 &amp;&amp; sp &lt; 2.5) { c = vec3(0.80, 0.62, 1.0); } if (sp &gt; 3.5 &amp;&amp; sp &lt; 4.5) { c = vec3(1.0, 0.34, 0.14); } if (sp &gt; 4.5 &amp;&amp; sp &lt; 5.5) { c = vec3(1.0, 0.52, 0.06); } if (sp &gt; 5.5 &amp;&amp; sp &lt; 6.5) { c = vec3(1.0, 0.80, 0.20); } if (sp &gt; 6.5) { c = vec3(0.80, 0.85, 0.90); } return c; } void main() { float t = u_phase * 12.0; float age = t - 0.5 - v_ident.w; float head = age * 0.9; if (v_arc &gt; head) { discard; } float v = v_look.x; float core = exp(-v * v * 9.0); float halo = exp(-v * v * 2.2); float bright = clamp(log(1.0 + v_ident.z) / log(41.0), 0.0, 1.0); float seed = v_look.y; float neutral = step(0.5, v_look.w) * (1.0 - step(1.5, v_look.w)); float freq = 1.1 + 2.2 * hash(seed * 7.13); float pulse = pow(1.0 - fract(v_arc * freq - age * (0.6 + 0.7 * hash(seed * 3.7)) + hash(seed)), 6.0); float dash = mix(1.0, 0.18 + 0.82 * step(0.4, fract(v_arc * 14.0 + seed)), neutral); float growing = 1.0 - smoothstep(v_look.z, v_look.z + 0.25, head); float tip = exp(-max(head - v_arc, 0.0) * 9.0) * growing; float knot = 0.0; if (v_look.w &gt; 1.5) { float a1 = (v_rad - 2.60) * 9.0; float a2 = (v_rad - 3.00) * 9.0; knot = exp(-a1 * a1) + exp(-a2 * a2); } vec3 c = hue(v_species, v_ident.y); float gain = (0.28 + 1.35 * bright) * (0.62 + 0.95 * pulse) * dash * (1.0 - 0.65 * neutral); vec3 col = c * (halo * 0.34 + core * 0.9) * gain; col += vec3(1.0) * core * (0.22 * pulse * bright + 1.6 * tip + 0.9 * knot); col = vec3(1.0) - exp(-col * 1.15); gl_FragColor = vec4(col * smoothstep(0.0, 0.5, t) * (1.0 - smoothstep(10.4, 11.9, t)), 1.0); }"'/></ComposedShader>
<ComposedShader DEF='twrShader2' language='GLSL'><field name='u_phase' type='SFFloat' accessType='inputOutput' value='0'/><field name='u_e90' type='SFFloat' accessType='inputOutput' value='2.1653'/><ShaderPart type='VERTEX' url='"data:x-shader/x-vertex,precision highp float; uniform mat4 x3d_ModelViewMatrix; uniform mat4 x3d_ProjectionMatrix; attribute vec4 x3d_Vertex; uniform ivec4 x3d_Viewport; uniform float u_phase; attribute vec4 a_cell; attribute vec3 a_next; attribute vec4 a_look; varying vec4 v_cell; varying vec4 v_look; void main() { float t = u_phase * 12.0; vec3 c = x3d_Vertex.xyz - a_look.x * vec3(0.004, 0.0028, 0.0012); vec3 b = a_look.z &gt; 0.5 ? 2.0 * c - a_next : c; float g = smoothstep(a_cell.w, a_cell.w + 0.5, t); vec3 p = mix(b, c, max(g, 0.02)); vec4 c0 = x3d_ProjectionMatrix * (x3d_ModelViewMatrix * vec4(p, 1.0)); vec4 c1 = x3d_ProjectionMatrix * (x3d_ModelViewMatrix * vec4(a_next, 1.0)); vec2 hv = vec2(x3d_Viewport.zw) * 0.5; vec2 d = (c1.xy / c1.w - c0.xy / c0.w) * hv; float l = length(d); d = l &gt; 0.0001 ? d / l : vec2(1.0, 0.0); float e = clamp(log(1.0 + a_cell.y) / log(31.0), 0.0, 1.0); float w = 0.8 + 1.4 * e; vec2 o = vec2(-d.y, d.x) * a_look.x * w; gl_Position = c0 + vec4(o / hv * c0.w, 0.0, 0.0); v_cell = a_cell; v_look = a_look; }"'/><ShaderPart type='FRAGMENT' url='"data:x-shader/x-fragment,precision highp float; uniform float u_phase; uniform float u_e90; varying vec4 v_cell; varying vec4 v_look; void main() { float t = u_phase * 12.0; float e = clamp(log(1.0 + v_cell.y) / log(31.0), 0.0, 1.0); float eh = clamp(log(1.0 + v_cell.y) / log(1.0 + max(u_e90, 0.05)), 0.0, 1.0); vec3 heat = mix(vec3(0.16, 0.48, 1.0), vec3(1.0, 0.56, 0.10), smoothstep(0.25, 0.80, eh)); vec3 c = mix(heat, vec3(1.0, 0.78, 0.30), 0.35 * v_cell.z); float lit = smoothstep(v_cell.w, v_cell.w + 0.15, t); float flare = exp(-max(t - v_cell.w, 0.0) * 2.0) * lit; float u = v_look.z; float v = v_look.x; float core = exp(-v * v * 8.0); float halo = exp(-v * v * 2.0); float shimmer = 0.86 + 0.14 * sin(t * 9.0 + v_look.y * 40.0); vec3 col = c * (core * 1.25 + halo * 0.4) * (0.4 + 1.1 * e) * (1.0 - 0.5 * u) * lit * shimmer; col += vec3(1.0, 0.93, 0.82) * core * exp(-u * 4.0) * (0.2 + 0.6 * e) * (0.5 + 0.5 * v_cell.z) * lit * 0.3; col += vec3(1.0) * core * flare * 0.7; col = vec3(1.0) - exp(-col * 0.95); gl_FragColor = vec4(col * smoothstep(0.0, 0.5, t) * (1.0 - smoothstep(10.4, 11.9, t)), 1.0); }"'/></ComposedShader>
<ComposedShader DEF='shellShader2' language='GLSL'><field name='u_phase' type='SFFloat' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX' url='"data:x-shader/x-vertex,precision highp float; uniform mat4 x3d_ModelViewMatrix; uniform mat4 x3d_ProjectionMatrix; attribute vec4 x3d_Vertex; uniform mat3 x3d_NormalMatrix; attribute vec3 x3d_Normal; attribute vec4 a_shell; attribute vec4 a_geo; varying vec3 v_n; varying vec3 v_p; varying vec3 v_obj; varying vec4 v_shell; varying vec4 v_geo; void main() { vec4 p = x3d_ModelViewMatrix * x3d_Vertex; v_p = p.xyz; v_n = x3d_NormalMatrix * x3d_Normal; v_obj = x3d_Vertex.xyz; v_shell = a_shell; v_geo = a_geo; gl_Position = x3d_ProjectionMatrix * p; }"'/><ShaderPart type='FRAGMENT' url='"data:x-shader/x-fragment,precision highp float; uniform float u_phase; varying vec3 v_n; varying vec3 v_p; varying vec3 v_obj; varying vec4 v_shell; varying vec4 v_geo; void main() { float t = u_phase * 12.0; vec3 N = normalize(v_n); vec3 V = normalize(-v_p); float fres = pow(1.0 - abs(dot(N, V)), 3.0); float z = v_obj.z; float r = v_geo.x; float hl = v_geo.y; float ang = atan(v_obj.y, v_obj.x); float face = abs(dot(N, V)); float rib = smoothstep(0.88, 1.0, abs(sin(z * v_shell.y))) * smoothstep(0.12, 0.35, face); float pan = smoothstep(0.965, 1.0, abs(sin(ang * v_geo.z * 0.5))); float steel = step(1.5, v_shell.x) * (1.0 - step(2.5, v_shell.x)); float endg = exp(-max(hl - abs(z), 0.0) * 14.0) * (1.0 - steel); float front = (t - 0.5) * 3.0; float rip = exp(-(front - r) * (front - r) * 6.0) * step(0.0, t - 0.5); float k = v_shell.x; vec3 c = vec3(0.34, 0.52, 0.80); if (k &gt; 0.5) { c = vec3(0.50, 0.74, 1.0); } if (k &gt; 1.5) { c = vec3(0.14, 0.22, 0.36) * smoothstep(0.05, 0.30, face); } if (k &gt; 2.5) { c = vec3(0.24, 0.46, 0.85); } float b = v_shell.w; float lip = smoothstep(hl - 0.12, hl, abs(z)); vec3 col = c * (fres * 0.8 * mix(0.3, 1.0, lip) + 0.025) * b; col += c * (rib * 0.5 + pan * 0.3) * (0.18 + 0.82 * fres) * b * (1.0 - 0.4 * steel); col += vec3(0.72, 0.86, 1.0) * endg * b * 0.85; col += vec3(1.0, 0.52, 0.12) * v_shell.z * (0.06 + 0.94 * fres * fres) * smoothstep(2.0, 3.6, t); col += vec3(0.6, 0.85, 1.0) * rip * 0.7 * b; col = vec3(1.0) - exp(-col * 1.35); gl_FragColor = vec4(col * (0.35 + 0.65 * smoothstep(0.0, 0.5, t) * (1.0 - smoothstep(10.4, 11.9, t))), 1.0); }"'/></ComposedShader>
<ComposedShader DEF='flashShader2' language='GLSL'><field name='u_phase' type='SFFloat' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX' url='"data:x-shader/x-vertex,precision highp float; uniform mat4 x3d_ModelViewMatrix; uniform mat4 x3d_ProjectionMatrix; attribute vec4 x3d_Vertex; varying vec2 v_uv; void main() { v_uv = x3d_Vertex.xy; gl_Position = x3d_ProjectionMatrix * (x3d_ModelViewMatrix * x3d_Vertex); }"'/><ShaderPart type='FRAGMENT' url='"data:x-shader/x-fragment,precision highp float; uniform float u_phase; varying vec2 v_uv; void main() { float t = u_phase * 12.0; float s = t - 0.5; float bang = exp(-max(s, 0.0) * 1.8) * step(0.0, s); float level = (0.15 + 0.85 * smoothstep(0.0, 0.5, t)) * (0.35 + 2.4 * bang); vec2 p = v_uv; float r = length(p); float glow = exp(-r * r * 16.0) * 1.1 + 0.22 / (1.0 + r * r * 140.0); float st = exp(-abs(p.y) * 55.0) * exp(-abs(p.x) * 2.2) + exp(-abs(p.x) * 55.0) * exp(-abs(p.y) * 2.2); float dg = exp(-abs(p.x - p.y) * 60.0) * exp(-abs(p.x + p.y) * 3.5) + exp(-abs(p.x + p.y) * 60.0) * exp(-abs(p.x - p.y) * 3.5); float edge = 1.0 - smoothstep(0.7, 1.0, r); vec3 col = vec3(0.86, 0.93, 1.0) * (glow + (0.45 * st + 0.16 * dg) * (0.5 + bang)) * edge * level; col = vec3(1.0) - exp(-col * 1.6); gl_FragColor = vec4(col * (1.0 - smoothstep(10.4, 11.9, t)), 1.0); }"'/></ComposedShader>
<ComposedShader DEF='hazeShader2' language='GLSL'><field name='u_phase' type='SFFloat' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX' url='"data:x-shader/x-vertex,precision highp float; attribute vec4 x3d_Vertex; varying vec2 v_uv; void main() { v_uv = x3d_Vertex.xy; gl_Position = vec4(x3d_Vertex.xy, 0.9999, 1.0); }"'/><ShaderPart type='FRAGMENT' url='"data:x-shader/x-fragment,precision highp float; uniform float u_phase; varying vec2 v_uv; float h(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); } float n(vec2 p) { vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f); return mix(mix(h(i), h(i + vec2(1.0, 0.0)), f.x), mix(h(i + vec2(0.0, 1.0)), h(i + vec2(1.0, 1.0)), f.x), f.y); } float fbm(vec2 p) { float a = 0.5; float s = 0.0; for (float i = 0.0; i &lt; 4.5; i += 1.0) { s += a * n(p); p = p * 2.03 + vec2(1.7, 9.2); a *= 0.5; } return s; } void main() { float t = u_phase * 12.0; vec2 p = v_uv * vec2(1.78, 1.0); float r = length(p); float f = fbm(p * 1.5 + vec2(t * 0.03, -t * 0.02)); float g = fbm(p * 4.2 - vec2(t * 0.05, 0.0)); float smoke = smoothstep(0.38, 0.95, f) * (0.55 + 0.45 * g); float vign = exp(-r * r * 0.3); vec3 col = vec3(0.016, 0.040, 0.085) * vign + vec3(0.045, 0.090, 0.160) * smoke * (0.5 + 0.5 * r); col += vec3(0.05, 0.10, 0.19) * smoothstep(0.86, 0.70, r) * (0.6 + 0.4 * smoke); gl_FragColor = vec4(col, 1.0); }"'/></ComposedShader>
