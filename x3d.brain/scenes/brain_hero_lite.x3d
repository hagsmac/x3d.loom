<Switch DEF='SW_HEMI_L' whichChoice='0'><Group DEF='G_CORTEX_L'><Shape DEF='SHAPE_CORTEX_L'><Appearance><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_CORTEX_L' language='GLSL'><field name='rimColor' type='SFColor' accessType='inputOutput' value='0.42 0.97 1'/><field name='rimColor2' type='SFColor' accessType='inputOutput' value='1 0.47 0.97'/><field name='bodyColor' type='SFColor' accessType='inputOutput' value='0.55 0.78 1'/><field name='rimPower' type='SFFloat' accessType='inputOutput' value='2.2'/><field name='baseAlpha' type='SFFloat' accessType='inputOutput' value='0.03'/><field name='rimAlpha' type='SFFloat' accessType='inputOutput' value='1'/><field name='aoGamma' type='SFFloat' accessType='inputOutput' value='1.5'/><field name='specular' type='SFFloat' accessType='inputOutput' value='1.6'/><field name='backDim' type='SFFloat' accessType='inputOutput' value='0.12'/><field name='sulcAlpha' type='SFFloat' accessType='inputOutput' value='0.5'/><field name='sulcColor' type='SFColor' accessType='inputOutput' value='0.004 0.03 0.06'/><field name='sulcLo' type='SFFloat' accessType='inputOutput' value='0.0'/><field name='sulcHi' type='SFFloat' accessType='inputOutput' value='0.14'/><field name='edgeColor' type='SFColor' accessType='inputOutput' value='0.8 0.97 1'/><field name='edgeAlpha' type='SFFloat' accessType='inputOutput' value='0.9'/><field name='edgeLo' type='SFFloat' accessType='inputOutput' value='0.12'/><field name='edgeW' type='SFFloat' accessType='inputOutput' value='0.25'/><field name='farDim' type='SFFloat' accessType='inputOutput' value='0.12'/><field name='farR' type='SFFloat' accessType='inputOutput' value='50'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out float vAO; out float vRel;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vN = x3d_NormalMatrix * x3d_Normal; vAO = clamp((x3d_Color.g - 0.17) / 0.83, 0.0, 1.0);
  vRel = p.z - (x3d_ModelViewMatrix * vec4(0.0, 0.0, 0.0, 1.0)).z;      // view-space depth relative to the model centre: > 0 nearer than the centre, < 0 farther
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 rimColor; uniform vec3 rimColor2; uniform vec3 bodyColor;
uniform float rimPower; uniform float baseAlpha; uniform float rimAlpha; uniform float aoGamma; uniform float specular; uniform float backDim; uniform float sulcAlpha; uniform vec3 sulcColor; uniform float sulcLo; uniform float sulcHi;
uniform vec3 edgeColor; uniform float edgeAlpha; uniform float edgeLo; uniform float edgeW; uniform float farDim; uniform float farR;
in vec3 vN; in vec3 vP; in float vAO; in float vRel; out vec4 fragColor;
void main(){
  vec3 N = normalize(vN); vec3 V = normalize(-vP);
  float d = dot(N, V); float fr = step(0.0, d); float ndv = abs(d);
  vec3 Nf = (d < 0.0) ? -N : N;
  float ao = pow(clamp(vAO, 0.0, 1.0), aoGamma);                // 0 in sulcal fundi, 1 on gyral crowns
  float cr = smoothstep(sulcLo, sulcHi, ao);
  float f = pow(1.0 - ndv, rimPower);
  float hue = smoothstep(-0.15, 0.95, N.x * 0.85 - N.y * 0.55 + 0.25 * sin(vP.y * 0.045 + vP.x * 0.03));
  vec3 rimc = mix(rimColor, rimColor2, hue);
  float film = 0.5 + 0.5 * cos(6.2831853 * (ndv * 1.7 + 0.35 * ao));
  rimc = mix(rimc, rimc.zxy * vec3(0.9, 1.0, 1.0) + 0.1, 0.28 * film * f);
  vec3 L1 = normalize(vec3(-0.5, 0.7, 0.55)); vec3 H1 = normalize(L1 + V);
  vec3 L2 = normalize(vec3(0.85, -0.15, 0.45)); vec3 H2 = normalize(L2 + V);
  float s1 = pow(max(dot(Nf, H1), 0.0), 90.0) * (0.2 + 0.8 * cr);
  float s2 = pow(max(dot(Nf, H2), 0.0), 30.0) * 0.30 * cr;
  float dif = 0.6 + 0.4 * dot(Nf, L1);
  vec3 body = mix(sulcColor, bodyColor * dif, cr);      // dark teal in the sulci, pale blue glass on the crowns
  float aBody = mix(sulcAlpha, baseAlpha, cr);                                // sulci are dense, crowns are thin
  float aRim = rimAlpha * f * (0.35 + 0.65 * cr);
  float k = mix(backDim, 1.0, fr);
  vec3 spec = (vec3(1.0, 0.97, 0.92) * s1 + vec3(0.45, 0.75, 1.0) * s2) * specular * fr;
  float aSp = clamp((s1 + s2) * specular, 0.0, 1.0) * fr;
  float aTot = clamp((aBody + aRim) * k, 0.0, 1.0);
  vec3 col = (body * aBody + rimc * aRim) / max(aBody + aRim, 0.001);
  // gyral outline: a thin bright band where the occlusion climbs from fundus to crown (the glass-tube look); lit side brighter
  float ridge = smoothstep(edgeLo, edgeLo + edgeW, ao) * (1.0 - smoothstep(edgeLo + edgeW, edgeLo + 2.2 * edgeW, ao));
  float aEdge = clamp(edgeAlpha * ridge * (0.5 + 0.5 * pow(max(dot(Nf, H1), 0.0), 2.0)), 0.0, 1.0) * mix(0.35, 1.0, fr);
  col = mix(col, edgeColor, aEdge / max(aTot + aEdge, 0.001)); aTot = aTot + aEdge * (1.0 - aTot);
  float depthK = mix(farDim, 1.0, smoothstep(-farR, 0.35 * farR, vRel));      // depth cue: surfaces beyond the model centre fade, so the near shell reads crisp
  aTot *= depthK; aSp *= depthK;
  float a = clamp(aTot + aSp * (1.0 - aTot), 0.0, 1.0);
  col = mix(col, spec / max(aSp, 0.001) + col * 0.0, clamp(aSp / max(a, 0.001), 0.0, 1.0));
  fragColor = vec4(clamp(col, 0.0, 1.0), a);
}
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet DEF='GEO_CORTEX_L' index='0 2564 2562 0 2562 2565 0 2565 2567 0 2567 2569 0 2569 2564 3 2574 2572 3 2572 2575 3 2575 2577 4 2581 2579 4 2579 2582 5 2586 2584 5 2584 2587 1 2591 2589 1 2589 2592 2 2596 2594 9 2602 2600 10 2605 2603 6 2608 2606 7 2611 2609 12 2614 2612 14 2617 2615 14 2619 2617 15 2622 2620 12 2625 2623 12 2612 2625 17 2629 2627 15 2632 2630 15 2620 2632 19 2636 2634 17 2639 2637 17 2627 2639 14 2642 2619 19 2645 2643 19 2634 2645 22 2649 2647 21 2652 2650 21 2654 2652 24 2657 2655 22 2660 2658 22 2647 2660 13 2664 2662 24 2667 2665 24 2655 2667 27 2671 2669 26 2674 2672 26 2676 2674 16 2679 2677 27 2682 2680 27 2669 2682 30 2686 2684 29 2689 2687 29 2691 2689 18 2694 2692 30 2697 2695 30 2684 2697 33 2701 2699 32 2704 2702 32 2706 2704 20 2709 2707 33 2712 2710 33 2699 2712 35 2719 2717 35 2721 2719 25 2724 2722 28 2732 2730 37 2735 2733 37 2737 2735 31 2740 2738 39 2743 2741 39 2745 2743 34 2748 2746 40 2751 2749 40 2753 2751 41 2759 2757 41 2761 2759 42 2764 2762 44 2767 2765 44 2769 2767 45 2772 2770 42 2775 2773 42 2762 2775 47 2779 2777 45 2782 2780 45 2770 2782 49 2786 2784 47 2789 2787 47 2777 2789 44 2792 2769 49 2795 2793 49 2784 2795 52 2799 2797 54 2802 2800 54 2804 2802 55 2807 2805 52 2810 2808 52 2797 2810 57 2814 2812 55 2817 2815 55 2805 2817 59 2821 2819 61 2824 2822 61 2826 2824 62 2829 2827 59 2832 2830 59 2819 2832 64 2836 2834 66 2839 2837 66 2841 2839 67 2844 2842 64 2847 2845 64 2834 2847 69 2851 2849 71 2854 2852 71 2856 2854 72 2859 2857 69 2862 2860 69 2849 2862 74 2866 2864 76 2869 2867 76 2871 2869 77 2874 2872 80 2882 2880 82 2885 2883 82 2887 2885 83 2890 2888 85 2893 2891 85 2895 2893 86 2898 2896 88 2901 2899 88 2903 2901 91 2909 2907 91 2911 2909 92 2914 2912 94 2917 2915 94 2919 2917 43 2922 2920 95 2925 2923 95 2927 2925 95 2929 2927 96 2932 2930 96 2934 2932 97 2937 2935 99 2940 2938 99 2942 2940 46 2945 2943 100 2948 2946 100 2950 2948 100 2952 2950