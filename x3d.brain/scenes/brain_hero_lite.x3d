<Switch DEF='SW_AURA' whichChoice='0'><Group DEF='G_AURA'><Transform scale='1.03 1.03 1.03'>
<Shape DEF='SHAPE_AURA_L'><Appearance><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_AURA_L' language='GLSL'><field name='auraColor' type='SFColor' accessType='inputOutput' value='0.25 0.8 1'/><field name='auraColor2' type='SFColor' accessType='inputOutput' value='0.8 0.4 1'/><field name='auraPower' type='SFFloat' accessType='inputOutput' value='4'/><field name='auraAlpha' type='SFFloat' accessType='inputOutput' value='0.6'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out float vAO; out float vRel;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vN = x3d_NormalMatrix * x3d_Normal; vAO = clamp((x3d_Color.g - 0.17) / 0.83, 0.0, 1.0);
  vRel = p.z - (x3d_ModelViewMatrix * vec4(0.0, 0.0, 0.0, 1.0)).z;      // view-space depth relative to the model centre: > 0 nearer than the centre, < 0 farther
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 auraColor; uniform vec3 auraColor2; uniform float auraPower; uniform float auraAlpha;
in vec3 vN; in vec3 vP; in float vAO; in float vRel; out vec4 fragColor;
void main(){
  vec3 N = normalize(vN); vec3 V = normalize(-vP);
  float d = dot(N, V);
  float f = pow(1.0 - clamp(d, 0.0, 1.0), auraPower) * step(0.0, d);
  float hue = smoothstep(-0.55, 0.65, N.x * 0.85 - N.y * 0.55);
  fragColor = vec4(mix(auraColor, auraColor2, hue), clamp(f * auraAlpha * (0.4 + 0.6 * smoothstep(0.0, 0.8, vAO)) * mix(0.35, 1.0, smoothstep(-70.0, 25.0, vRel)), 0.0, 1.0));
}
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet USE='GEO_CORTEX_L'/></Shape>
<Shape DEF='SHAPE_AURA_R'><Appearance><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_AURA_R' language='GLSL'><field name='auraColor' type='SFColor' accessType='inputOutput' value='0.25 0.8 1'/><field name='auraColor2' type='SFColor' accessType='inputOutput' value='0.8 0.4 1'/><field name='auraPower' type='SFFloat' accessType='inputOutput' value='4'/><field name='auraAlpha' type='SFFloat' accessType='inputOutput' value='0.6'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out float vAO; out float vRel;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vN = x3d_NormalMatrix * x3d_Normal; vAO = clamp((x3d_Color.g - 0.17) / 0.83, 0.0, 1.0);
  vRel = p.z - (x3d_ModelViewMatrix * vec4(0.0, 0.0, 0.0, 1.0)).z;      // view-space depth relative to the model centre: > 0 nearer than the centre, < 0 farther
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 auraColor; uniform vec3 auraColor2; uniform float auraPower; uniform float auraAlpha;
in vec3 vN; in vec3 vP; in float vAO; in float vRel; out vec4 fragColor;
void main(){
  vec3 N = normalize(vN); vec3 V = normalize(-vP);
  float d = dot(N, V);
  float f = pow(1.0 - clamp(d, 0.0, 1.0), auraPower) * step(0.0, d);
  float hue = smoothstep(-0.55, 0.65, N.x * 0.85 - N.y * 0.55);
  fragColor = vec4(mix(auraColor, auraColor2, hue), clamp(f * auraAlpha * (0.4 + 0.6 * smoothstep(0.0, 0.8, vAO)) * mix(0.35, 1.0, smoothstep(-70.0, 25.0, vRel)), 0.0, 1.0));
}
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet USE='GEO_CORTEX_R'/></Shape>
