<Switch DEF='SW_SKIN' whichChoice='0'><Group DEF='G_SKIN'><Shape DEF='STRUCT_skin'><Appearance DEF='APP_SKIN'><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_SKIN' language='GLSL'><field name='rimColor' type='SFColor' accessType='inputOutput' value='0.36 0.78 1.00'/><field name='bodyColor' type='SFColor' accessType='inputOutput' value='0.07 0.26 0.46'/><field name='rimPower' type='SFFloat' accessType='inputOutput' value='2.1'/><field name='baseAlpha' type='SFFloat' accessType='inputOutput' value='0.045'/><field name='rimAlpha' type='SFFloat' accessType='inputOutput' value='0.95'/><field name='useColor' type='SFFloat' accessType='initializeOnly' value='1'/><field name='smoke' type='SFFloat' accessType='inputOutput' value='0'/><field name='time' type='SFTime' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix; uniform float useColor;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out vec3 vO; out vec2 vC;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vO = x3d_Vertex.xyz;
  vN = normalize(x3d_NormalMatrix * x3d_Normal); vC = useColor > 0.5 ? x3d_Color.rg : vec2(1.0);
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 rimColor; uniform vec3 bodyColor; uniform float rimPower; uniform float baseAlpha; uniform float rimAlpha;
uniform float smoke; uniform float time;
in vec3 vN; in vec3 vP; in vec3 vO; in vec2 vC; out vec4 fragColor;
float hash(vec3 p){ p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float vnoise(vec3 x){ vec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x), mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
             mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x), mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y), f.z); }
void main(){ vec3 N = normalize(vN); vec3 V = normalize(-vP); float ndv = abs(dot(N, V));
  float f = pow(1.0 - ndv, rimPower);
  float ao = vC.x; float fade = vC.y;
  vec3 col = mix(bodyColor * ao, rimColor, f);
  float a = mix(baseAlpha, rimAlpha, f) * mix(1.4, 0.8, ao);
  if (smoke > 0.0) { vec3 q = vO * 0.016 + vec3(0.0, time * 0.035, time * 0.02);
    float n = 0.55 * vnoise(q) + 0.30 * vnoise(q * 2.3 + 7.1) + 0.15 * vnoise(q * 5.1 + 3.3);
    float s = smoothstep(0.30, 0.70, n);
    a *= mix(1.0, 0.2 + 1.25 * s, smoke); col = mix(col, col * (0.6 + 0.8 * s), smoke); }
  fragColor = vec4(col, clamp(a * fade, 0.0, 1.0)); }
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet index='0 53 56 55 0 1 2 0 56 57 2 56 57 59 2 0 3 1 2 3 0 62 2 59 7 1 5 1 3 5 4 2 62 6 4 62 7 5 8 8 5 10 5 9 10 3 9 5 6 14 4 14 2 4 66 14 6 3 13 9 11 14 66 10 13 12 9 13 10 16 14 11 13 15 12 16 19 14 15 17 18 13 17 15 74 19 16 17 22 18 22 17 20 23 20 17 28 17 13 74 21 19 3 2 13 24 21 76 35 28 13 19 26 14 26 40 14 23 25 20 17 28 23 21 26 19 78 21 24 25 23 27 78 82 21 21 82 26 40 13 2 14 40 2 28 27 23 40 45 13 82 29 26 28 32 27 26 29 31 34 32 28 30 35 13 13 45 30 29 33 31 35 34 28 31 39 26 29 87 33 35 37 34 39 40 26 33 36 31 87 36 33 31 36 39 38 37 35 30 38 35 42 38 30 36 41 39 39 43 40 41 43 39 45 44 30 42 30 44 43 46 40 40 47 45 40 46 47 43 98 46 96 98 43 41 96 43 45 48 44 97 47 46 50 48 45 45 49 50 47 49 45 47 51 49 52 51 47 52 47 97 58 140 55 54 56 53 57 56 54 140 0 55 53 0 140 106 59 57 59 106 60 62 59 60 55 1 61 1 7 61 61 7 64 62 60 63 62 63 6 64 7 65 6 63 109 65 7 8 110 66 109 66 6 109 65 8 67 111 66 110 8 68 67 8 10 68 66 111 112 10 12 68 68 12 69 66 112 71 66 71 11 70 69 15 69 12 15 115 11 71 73 70 15 115 72 11 15 18 73 16 11 72 16 72 116 117 16 116 75 73 18 74 16 117 18 22 75 119 74 117 74 76 21 119 76 74 20 77 22 76 121 24 121 147 24 123 77 20 25 123 20 125 78 24 125 24 147 25 27 79 126 78 125 27 80 79 78 126 82 27 32 80 80 32 84 29 82 83 83 82 126 32 86 84 85 29 83 86 32 127 87 29 151 151 29 85 32 34 127 88 127 34 88 34 89 34 37 89 87 129 130 37 90 89 36 87 130 130 91 36 92 90 37 92 37 38 41 36 94 94 36 91 92 38 93 93 38 42 42 132 93 42 99 132 94 95 41 154 96 41 95 154 41 42 44 99 97 46 156 156 46 98 100 99 44 44 48 100 101 100 48 50 101 48 50 102 101 104 102 50 49 104 50 104 49 51 52 97 137 103 52 137 105 104 51 52 105 51 140 160 53 53 160 161 54 53 161 161 163 54 57 54 163 57 163 106 55 61 58 106 141 60 141 142 60 61 64 107 60 142 108 65 107 64 108 63 60 63 108 109 67 143 65 68 171 67 68 69 173 69 114 173 113 114 70 114 69 70 144 113 70 70 73 144 115 174 72 116 236 117 145 73 75 175 119 117