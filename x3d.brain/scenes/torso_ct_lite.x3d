<Switch DEF='SW_VISCERA' whichChoice='-1'><Group DEF='G_VISCERA'><Shape DEF='STRUCT_colon'><Appearance DEF='APP_VISCERA'><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_VISCERA' language='GLSL'><field name='rimColor' type='SFColor' accessType='inputOutput' value='0.62 0.72 0.82'/><field name='bodyColor' type='SFColor' accessType='inputOutput' value='0.22 0.30 0.38'/><field name='rimPower' type='SFFloat' accessType='inputOutput' value='2.4'/><field name='baseAlpha' type='SFFloat' accessType='inputOutput' value='0.025'/><field name='rimAlpha' type='SFFloat' accessType='inputOutput' value='0.2'/><field name='useColor' type='SFFloat' accessType='initializeOnly' value='0'/><field name='smoke' type='SFFloat' accessType='inputOutput' value='0'/><field name='time' type='SFTime' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix; uniform float useColor;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out vec3 vO; out vec2 vC;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vO = x3d_Vertex.xyz;
  vN = normalize(x3d_NormalMatrix * x3d_Normal); vC = useColor > 0.5 ? x3d_Color.rg : vec2(1.0);
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 rimColor; uniform vec3 bodyColor; uniform float rimPower; uniform float baseAlpha; uniform float rimAlpha;
uniform float smoke; uniform float time;
in vec3 vN; in vec3 vP; in vec3 vO; in vec2 vC; out vec4 fragColor;
float hash(vec3 p){ p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float vnoise(vec3 x){ vec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x), mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
             mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x), mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y), f.z); }
void main(){ vec3 N = normalize(vN); vec3 V = normalize(-vP); float ndv = abs(dot(N, V));
  float f = pow(1.0 - ndv, rimPower);
  float ao = vC.x; float fade = vC.y;
  vec3 col = mix(bodyColor * ao, rimColor, f);
  float a = mix(baseAlpha, rimAlpha, f) * mix(1.4, 0.8, ao);
  if (smoke > 0.0) { vec3 q = vO * 0.016 + vec3(0.0, time * 0.035, time * 0.02);
    float n = 0.55 * vnoise(q) + 0.30 * vnoise(q * 2.3 + 7.1) + 0.15 * vnoise(q * 5.1 + 3.3);
    float s = smoothstep(0.30, 0.70, n);
    a *= mix(1.0, 0.2 + 1.25 * s, smoke); col = mix(col, col * (0.6 + 0.8 * s), smoke); }
  fragColor = vec4(col, clamp(a * fade, 0.0, 1.0)); }
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet index='2 1 0 2 4 1 1 3 0 1 4 5 2 9 4 1 5 3 9 2 0 0 3 7 6 9 0 0 7 6 5 4 10 9 8 4 7 3 5 21 5 10 4 8 10 6 11 9 13 11 6 7 13 6 20 9 11 14 13 7 7 15 14 19 23 18 9 20 8 5 21 7 24 12 16 12 25 17 16 12 17 18 23 22 8 20 32 16 17 31 25 12 35 31 17 26 32 10 8 21 10 46 21 15 7 33 12 24 18 48 19 22 23 27 23 19 28 46 10 32 33 35 12 26 17 25 19 48 42 32 20 29 29 20 11 33 15 21 33 24 15 27 23 28 29 11 13 14 15 24 14 24 16 19 42 28 45 30 34 38 25 35 25 38 26 22 57 18 43 33 21 31 26 39 18 56 48 27 28 36 13 37 29 33 43 35 35 43 34 34 30 35 31 39 16 47 35 30 64 28 42 32 29 46 21 44 43 37 14 16 50 37 16 41 39 26 57 56 18 22 27 40 27 36 40 13 14 37 43 53 34 16 39 50 61 45 34 54 26 38 28 64 36 44 21 46 35 47 38 30 45 59 57 22 40 51 57 40 73 42 48 64 42 73 44 46 65 43 44 68 34 53 61 30 55 47 41 58 39 49 40 36 38 71 54 26 54 41 55 30 59 73 48 56 51 40 49 36 52 49 64 52 36 65 68 44 43 68 53 50 39 58 47 71 38 56 80 73 41 54 58 59 45 61 60 59 61 59 62 55 60 62 59 46 29 65 58 54 89 61 92 60 56 57 80 51 63 57 51 49 63 76 49 52 73 74 64 84 47 55 71 47 84 57 63 72 78 64 74 78 104 64 65 29 95 29 37 95 68 65 94 50 95 37 61 53 70 62 66 55 90 77 67 117 73 80 76 63 49 64 121 52 58 69 50 79 70 53 69 58 89 60 85 62 80 57 72 67 77 75 104 121 64 95 50 69 68 79 53 110 71 84 71 96 54 101 90 67 91 77 90 67 75 82 81 77 91 74 73 117 52 83 76 121 83 52 94 79 68 61 70 97 54 96 89 55 66 84 99 66 62 92 85 60 67 82 102 63 76 119 74 126 78 88 77 81 77 88 75 104 78 87 62 85 99 67 86 101 67 102 86 76 83 119 75 88 103 79 94 105 70 79 97 71 110 96 113 90 101 100 90 93 100 91 90 80 72 117 107 126 74 91 118 81 82 75 114 114 75 103 126 87 78 109 83 121 65 95 94 84 105 110 79 105 84 84 98 79 61 97 92 66 98 84 113 93 90 74 117 107 170 121 104 97 79 116 116 79 98 111 93 113 93 99 100 106 100 99 85 106 99 63 119 72 119 83 120 129 170 104 94 95 115 94 115 105 93 111 122 93 122 99 113 112 111 106 124 100 86 125 101 124 91 100 102 82 134 119 117 72 81 118 88 88 118 