<Switch DEF='SW_SKULL' whichChoice='0'><Group DEF='G_SKULL'><Shape DEF='STRUCT_skull'><Appearance DEF='APP_SKULL'><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_SKULL' language='GLSL'><field name='rimColor' type='SFColor' accessType='inputOutput' value='0.66 0.92 1.00'/><field name='bodyColor' type='SFColor' accessType='inputOutput' value='0.22 0.50 0.80'/><field name='rimPower' type='SFFloat' accessType='inputOutput' value='2.3'/><field name='baseAlpha' type='SFFloat' accessType='inputOutput' value='0.05'/><field name='rimAlpha' type='SFFloat' accessType='inputOutput' value='0.72'/><field name='useColor' type='SFFloat' accessType='initializeOnly' value='1'/><field name='smoke' type='SFFloat' accessType='inputOutput' value='0'/><field name='time' type='SFTime' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix; uniform float useColor;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out vec3 vO; out vec2 vC;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vO = x3d_Vertex.xyz;
  vN = normalize(x3d_NormalMatrix * x3d_Normal); vC = useColor > 0.5 ? x3d_Color.rg : vec2(1.0);
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 rimColor; uniform vec3 bodyColor; uniform float rimPower; uniform float baseAlpha; uniform float rimAlpha;
uniform float smoke; uniform float time;
in vec3 vN; in vec3 vP; in vec3 vO; in vec2 vC; out vec4 fragColor;
float hash(vec3 p){ p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float vnoise(vec3 x){ vec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x), mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
             mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x), mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y), f.z); }
void main(){ vec3 N = normalize(vN); vec3 V = normalize(-vP); float ndv = abs(dot(N, V));
  float f = pow(1.0 - ndv, rimPower);
  float ao = vC.x; float fade = vC.y;
  vec3 col = mix(bodyColor * ao, rimColor, f);
  float a = mix(baseAlpha, rimAlpha, f) * mix(1.4, 0.8, ao);
  if (smoke > 0.0) { vec3 q = vO * 0.016 + vec3(0.0, time * 0.035, time * 0.02);
    float n = 0.55 * vnoise(q) + 0.30 * vnoise(q * 2.3 + 7.1) + 0.15 * vnoise(q * 5.1 + 3.3);
    float s = smoothstep(0.30, 0.70, n);
    a *= mix(1.0, 0.2 + 1.25 * s, smoke); col = mix(col, col * (0.6 + 0.8 * s), smoke); }
  fragColor = vec4(col, clamp(a * fade, 0.0, 1.0)); }
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet index='6 1 5 5 1 8 1 0 7 8 1 7 1 2 0 20 7 3 7 0 3 1 6 14 2 4 0 9 1 14 0 18 3 10 6 5 21 5 8 2 1 27 18 0 13 8 7 20 6 17 14 12 13 0 21 11 5 0 4 12 8 20 21 28 4 2 3 18 24 24 20 3 9 27 1 10 5 11 28 30 4 14 27 9 12 15 13 10 17 6 18 13 23 13 15 23 11 25 10 24 49 20 17 10 26 20 16 21 27 29 2 25 11 19 25 26 10 30 12 4 2 29 28 23 39 18 24 18 39 49 16 20 16 34 21 14 32 27 22 23 31 40 26 25 40 37 26 33 11 21 27 32 29 23 15 31 15 36 31 39 65 24 25 19 40 24 65 49 19 11 33 57 16 49 26 63 17 34 16 57 35 14 17 14 35 32 22 39 23 33 21 34 28 44 30 15 12 38 37 50 26 50 63 26 34 57 43 41 35 17 35 51 32 29 44 28 58 38 12 57 49 62 12 30 58 46 22 31 46 39 22 19 47 40 38 36 15 19 33 66 37 83 50 33 34 59 63 41 17 88 35 41 31 36 55 47 54 40 40 61 37 60 58 30 68 34 43 51 42 32 55 36 74 129 65 39 61 83 37 19 66 48 59 34 69 45 44 29 32 42 29 31 55 52 46 31 52 54 61 40 19 48 47 36 38 74 34 68 69 30 44 70 42 45 29 61 54 81 39 46 129 49 65 62 33 59 66 67 43 57 68 43 67 60 30 70 55 53 52 53 55 74 56 38 58 86 57 62 86 67 57 76 51 35 46 52 72 54 79 81 64 54 47 58 60 89 86 84 67 59 69 78 59 78 75 68 67 77 69 68 77 78 69 77 71 70 44 45 42 77 51 76 42 53 73 52 46 72 109 64 80 54 64 47 82 47 48 82 65 129 126 103 48 66 84 86 90 67 84 77 45 71 44 77 71 45 42 78 77 52 73 72 79 54 80 96 53 74 82 48 103 38 56 74 110 62 65 66 59 104 63 50 87 87 41 63 60 70 89 75 78 91 88 76 35 77 84 71 71 95 70 78 42 85 85 42 76 81 187 61 61 187 83 103 66 98 110 86 62 66 104 98 59 75 104 91 78 85 84 95 71 72 73 119 126 110 65 92 56 58 50 142 87 104 75 94 93 90 86 87 88 41 94 99 88 84 90 95 70 95 89 109 72 119 80 64 121 79 187 81 102 74 56 187 130 83 97 142 50 111 93 86 58 89 92 94 112 104 112 94 87 75 91 94 87 94 88 95 93 89 99 76 88 73 125 119 73 53 125 79 120 187 96 74 102 50 83 97 110 111 86 92 89 111 111 89 93 93 95 90 91 99 94 91 85 99 76 99 85 100 79 80 64 82 101 102 56 92 113 114 105 122 114 113 114 107 105 118 116 106 100 120 79 53 96 125 82 103 141 126 1