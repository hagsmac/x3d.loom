<Shape DEF='STRUCT_spinal_cord'><Appearance DEF='APP_CORD'><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_CORD' language='GLSL'><field name='rimColor' type='SFColor' accessType='inputOutput' value='1.00 0.86 0.55'/><field name='bodyColor' type='SFColor' accessType='inputOutput' value='0.80 0.62 0.30'/><field name='rimPower' type='SFFloat' accessType='inputOutput' value='1.6'/><field name='baseAlpha' type='SFFloat' accessType='inputOutput' value='0.35'/><field name='rimAlpha' type='SFFloat' accessType='inputOutput' value='0.85'/><field name='useColor' type='SFFloat' accessType='initializeOnly' value='0'/><field name='smoke' type='SFFloat' accessType='inputOutput' value='0'/><field name='time' type='SFTime' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix; uniform float useColor;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out vec3 vO; out vec2 vC;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vO = x3d_Vertex.xyz;
  vN = normalize(x3d_NormalMatrix * x3d_Normal); vC = useColor > 0.5 ? x3d_Color.rg : vec2(1.0);
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 rimColor; uniform vec3 bodyColor; uniform float rimPower; uniform float baseAlpha; uniform float rimAlpha;
uniform float smoke; uniform float time;
in vec3 vN; in vec3 vP; in vec3 vO; in vec2 vC; out vec4 fragColor;
float hash(vec3 p){ p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float vnoise(vec3 x){ vec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x), mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
             mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x), mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y), f.z); }
void main(){ vec3 N = normalize(vN); vec3 V = normalize(-vP); float ndv = abs(dot(N, V));
  float f = pow(1.0 - ndv, rimPower);
  float ao = vC.x; float fade = vC.y;
  vec3 col = mix(bodyColor * ao, rimColor, f);
  float a = mix(baseAlpha, rimAlpha, f) * mix(1.4, 0.8, ao);
  if (smoke > 0.0) { vec3 q = vO * 0.016 + vec3(0.0, time * 0.035, time * 0.02);
    float n = 0.55 * vnoise(q) + 0.30 * vnoise(q * 2.3 + 7.1) + 0.15 * vnoise(q * 5.1 + 3.3);
    float s = smoothstep(0.30, 0.70, n);
    a *= mix(1.0, 0.2 + 1.25 * s, smoke); col = mix(col, col * (0.6 + 0.8 * s), smoke); }
  fragColor = vec4(col, clamp(a * fade, 0.0, 1.0)); }
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet index='2 0 1 0 2 4 0 3 1 4 3 0 2 1 6 6 4 2 4 7 3 1 9 6 1 5 9 1 3 5 6 11 15 3 8 5 6 9 11 15 4 6 7 8 3 7 4 15 5 10 9 5 8 10 9 10 11 13 10 8 12 7 15 7 12 8 12 14 8 15 11 10 13 8 14 15 16 12 10 16 15 10 13 17 16 10 17 16 14 12 16 17 19 17 13 18 14 18 13 20 14 16 21 16 19 19 17 22 20 16 21 17 18 22 14 20 18 21 19 25 23 22 18 25 20 21 19 22 25 22 23 25 24 23 18 18 26 24 20 26 18 26 20 25 28 26 25 28 25 27 25 23 27 24 29 23 33 26 28 30 27 23 30 23 29 26 33 24 24 33 29 28 32 33 27 32 28 30 29 31 30 31 27 27 31 37 37 32 27 37 33 32 31 29 34 33 34 29 37 36 33 36 34 33 31 35 37 31 34 39 34 41 39 35 31 42 38 36 37 42 31 39 36 41 34 37 35 38 38 41 36 35 40 38 35 42 40 43 41 38 43 38 40 39 44 42 44 39 41 40 42 45 44 41 43 40 45 46 46 43 40 43 46 44 42 47 45 47 42 44 45 48 46 46 47 44 48 49 46 45 50 48 46 52 47 45 47 58 48 53 49 52 46 49 50 53 48 52 58 47 50 45 51 49 53 56 45 58 51 55 50 51 50 55 53 56 52 49 58 52 57 56 54 52 53 59 56 52 54 57 58 60 51 56 57 54 64 59 53 64 53 55 61 56 59 60 55 51 63 61 59 56 62 57 56 61 62 57 62 58 64 55 60 63 59 64 65 60 58 58 62 65 61 63 66 61 66 62 60 67 64 65 67 60 65 62 68 65 68 67 70 64 67 75 66 63 67 68 69 62 71 68 63 70 75 63 64 70 69 68 73 71 73 68 67 69 70 66 71 62 71 66 75 69 73 72 69 74 70 69 72 74 73 77 72 70 76 75 71 80 73 75 80 71 70 74 76 76 80 75 72 78 74 74 78 76 73 80 77 78 79 76 82 78 72 80 83 77 78 82 79 72 77 82 76 81 80 79 81 76 81 83 80 79 82 81 83 84 77 84 87 77 81 85 83 85 84 83 88 87 84 81 82 86 82 77 87 86 85 81 86 82 87 84 85 88 87 89 86 86 90 85 86 89 90 90 93 85 91 88 85 93 91 85 89 92 90 87 94 89 87 88 94 92 89 94 94 88 96 93 90 92 91 96 88 93 97 91 94 95 99 94 99 92 96 95 94 99 93 92 93 99 97 97 96 91 99 95 100 97 99 98 97 101 96 100 98 99 100 95 102 98 104 97 96 102 95 101 103 96 104 101 97 103 102 96 98 100 105 100 102 105 98 106 104 104 103 101 98 105 106 105 102 108 104 111 103 108 102 103 104 106 111 108 107 105 105 107 110 106 105 110 111 112 1