<Shape DEF='STRUCT_liver'><Appearance DEF='APP_LIVER'><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_LIVER' language='GLSL'><field name='rimColor' type='SFColor' accessType='inputOutput' value='1.00 0.58 0.30'/><field name='bodyColor' type='SFColor' accessType='inputOutput' value='0.62 0.28 0.12'/><field name='rimPower' type='SFFloat' accessType='inputOutput' value='2.0'/><field name='baseAlpha' type='SFFloat' accessType='inputOutput' value='0.065'/><field name='rimAlpha' type='SFFloat' accessType='inputOutput' value='0.55'/><field name='useColor' type='SFFloat' accessType='initializeOnly' value='0'/><field name='smoke' type='SFFloat' accessType='inputOutput' value='0'/><field name='time' type='SFTime' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix; uniform float useColor;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out vec3 vO; out vec2 vC;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vO = x3d_Vertex.xyz;
  vN = normalize(x3d_NormalMatrix * x3d_Normal); vC = useColor > 0.5 ? x3d_Color.rg : vec2(1.0);
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 rimColor; uniform vec3 bodyColor; uniform float rimPower; uniform float baseAlpha; uniform float rimAlpha;
uniform float smoke; uniform float time;
in vec3 vN; in vec3 vP; in vec3 vO; in vec2 vC; out vec4 fragColor;
float hash(vec3 p){ p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float vnoise(vec3 x){ vec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x), mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
             mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x), mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y), f.z); }
void main(){ vec3 N = normalize(vN); vec3 V = normalize(-vP); float ndv = abs(dot(N, V));
  float f = pow(1.0 - ndv, rimPower);
  float ao = vC.x; float fade = vC.y;
  vec3 col = mix(bodyColor * ao, rimColor, f);
  float a = mix(baseAlpha, rimAlpha, f) * mix(1.4, 0.8, ao);
  if (smoke > 0.0) { vec3 q = vO * 0.016 + vec3(0.0, time * 0.035, time * 0.02);
    float n = 0.55 * vnoise(q) + 0.30 * vnoise(q * 2.3 + 7.1) + 0.15 * vnoise(q * 5.1 + 3.3);
    float s = smoothstep(0.30, 0.70, n);
    a *= mix(1.0, 0.2 + 1.25 * s, smoke); col = mix(col, col * (0.6 + 0.8 * s), smoke); }
  fragColor = vec4(col, clamp(a * fade, 0.0, 1.0)); }
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet index='11 1 0 3 1 11 2 1 3 11 0 10 1 4 0 1 2 4 5 4 2 7 2 3 10 0 8 5 2 7 8 20 10 9 0 4 4 5 15 3 14 7 5 7 26 8 0 9 9 4 19 19 4 15 11 6 3 3 17 14 18 26 7 10 20 12 10 12 11 6 17 3 16 5 26 18 7 14 13 9 19 27 6 11 20 8 22 24 5 16 9 13 8 12 27 11 6 33 17 15 5 24 17 28 14 28 18 14 22 8 13 27 12 30 13 19 23 15 23 19 31 26 18 26 21 16 12 20 32 27 33 6 24 16 25 21 25 16 22 13 43 33 28 17 15 24 46 22 32 20 32 30 12 28 31 18 35 21 26 23 15 46 40 25 21 31 35 26 32 22 36 43 13 38 21 29 40 21 35 29 22 43 36 13 23 34 27 30 37 27 37 44 46 34 23 28 33 39 49 35 31 30 32 37 27 44 33 44 52 33 47 24 25 28 39 31 33 52 39 35 42 29 32 41 37 39 49 31 35 49 50 32 36 59 36 43 79 44 37 48 13 34 70 35 50 42 53 59 36 79 53 36 43 54 79 41 66 37 46 24 47 67 49 39 47 25 40 58 40 29 32 59 41 38 13 45 13 70 45 46 70 34 52 67 39 47 40 58 50 55 42 42 51 29 37 66 48 52 44 48 70 46 47 55 50 49 29 51 58 43 38 45 52 78 67 42 55 56 51 42 56 45 70 61 59 53 84 59 60 41 48 78 52 70 47 62 49 67 63 57 47 58 55 49 68 55 65 56 80 48 66 62 47 64 64 47 57 49 63 68 51 56 58 71 65 55 56 77 58 72 84 53 60 59 84 41 60 66 69 54 43 45 69 43 80 78 48 63 67 74 68 71 55 66 60 95 53 79 72 69 45 61 73 67 78 77 88 58 66 90 80 70 62 81 73 74 67 75 63 74 63 75 68 68 75 71 58 88 57 65 83 56 65 93 83 81 62 64 75 76 71 56 83 77 84 89 60 60 89 95 85 72 79 78 80 87 78 87 73 74 103 75 77 83 82 66 95 90 54 96 79 73 104 74 71 76 97 65 71 97 69 96 54 73 87 108 81 64 101 57 88 92 88 77 82 97 93 65 72 85 84 103 74 104 64 57 94 90 91 80 86 61 70 108 104 73 101 64 94 57 92 94 75 103 109 84 85 100 79 96 85 95 106 90 80 118 87 118 108 87 98 82 83 89 110 95 69 61 86 80 91 118 105 92 88 98 83 93 84 99 89 100 99 84 96 100 85 90 107 91 75 141 76 88 82 105 97 122 93 99 110 89 103 104 102 75 109 141 97 76 141 110 106 95 116 69 86 105 82 112 112 82 98 117 98 93 110 145 106 90 106 115 90 115 107 125 96 69 70 81 114 122 97 121 93 122 117 86 70 126 108 136 104 104 136 102 69 116 125 126 70 1