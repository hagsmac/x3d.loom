<Transform DEF='HALO0_heart' center='-4.7 -34.1 -30.1' scale='1.03 1.03 1.03'><Shape><Appearance DEF='APP_HALO_HEART0'><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_HALO_HEART0' language='GLSL'><field name='rimColor' type='SFColor' accessType='inputOutput' value='1.0 0.55 0.22'/><field name='rimPower' type='SFFloat' accessType='inputOutput' value='2.0'/><field name='intensity' type='SFFloat' accessType='inputOutput' value='0.9'/><field name='useColor' type='SFFloat' accessType='initializeOnly' value='0'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix; uniform float useColor;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out vec3 vO; out vec2 vC;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vO = x3d_Vertex.xyz;
  vN = normalize(x3d_NormalMatrix * x3d_Normal); vC = useColor > 0.5 ? x3d_Color.rg : vec2(1.0);
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 rimColor; uniform float rimPower; uniform float intensity;
in vec3 vN; in vec3 vP; in vec3 vO; in vec2 vC; out vec4 fragColor;
void main(){ vec3 N = normalize(vN); vec3 V = normalize(-vP); float f = pow(1.0 - abs(dot(N, V)), rimPower);
  float a = clamp(f * intensity * vC.y, 0.0, 1.0); fragColor = vec4(rimColor, a); }
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet USE='GEO_heart'/></Shape></Transform>
<Transform DEF='HALO1_heart' center='-4.7 -34.1 -30.1' scale='1.08 1.08 1.08'><Shape><Appearance DEF='APP_HALO_HEART1'><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_HALO_HEART1' language='GLSL'><field name='rimColor' type='SFColor' accessType='inputOutput' value='1.0 0.42 0.14'/><field name='rimPower' type='SFFloat' accessType='inputOutput' value='3.0'/><field name='intensity' type='SFFloat' accessType='inputOutput' value='0.45'/><field name='useColor' type='SFFloat' accessType='initializeOnly' value='0'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
