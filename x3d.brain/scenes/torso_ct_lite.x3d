<Switch DEF='SW_RIBCAGE' whichChoice='0'><Group DEF='G_RIBCAGE'><Shape DEF='STRUCT_costal_cartilages'><Appearance DEF='APP_BONE'><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_BONE' language='GLSL'><field name='rimColor' type='SFColor' accessType='inputOutput' value='0.58 0.88 1.00'/><field name='bodyColor' type='SFColor' accessType='inputOutput' value='0.16 0.42 0.70'/><field name='rimPower' type='SFFloat' accessType='inputOutput' value='2.2'/><field name='baseAlpha' type='SFFloat' accessType='inputOutput' value='0.11'/><field name='rimAlpha' type='SFFloat' accessType='inputOutput' value='0.92'/><field name='useColor' type='SFFloat' accessType='initializeOnly' value='1'/><field name='smoke' type='SFFloat' accessType='inputOutput' value='0'/><field name='time' type='SFTime' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix; uniform float useColor;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out vec3 vO; out vec2 vC;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vO = x3d_Vertex.xyz;
  vN = normalize(x3d_NormalMatrix * x3d_Normal); vC = useColor > 0.5 ? x3d_Color.rg : vec2(1.0);
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 rimColor; uniform vec3 bodyColor; uniform float rimPower; uniform float baseAlpha; uniform float rimAlpha;
uniform float smoke; uniform float time;
in vec3 vN; in vec3 vP; in vec3 vO; in vec2 vC; out vec4 fragColor;
float hash(vec3 p){ p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float vnoise(vec3 x){ vec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x), mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
             mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x), mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y), f.z); }
void main(){ vec3 N = normalize(vN); vec3 V = normalize(-vP); float ndv = abs(dot(N, V));
  float f = pow(1.0 - ndv, rimPower);
  float ao = vC.x; float fade = vC.y;
  vec3 col = mix(bodyColor * ao, rimColor, f);
  float a = mix(baseAlpha, rimAlpha, f) * mix(1.4, 0.8, ao);
  if (smoke > 0.0) { vec3 q = vO * 0.016 + vec3(0.0, time * 0.035, time * 0.02);
    float n = 0.55 * vnoise(q) + 0.30 * vnoise(q * 2.3 + 7.1) + 0.15 * vnoise(q * 5.1 + 3.3);
    float s = smoothstep(0.30, 0.70, n);
    a *= mix(1.0, 0.2 + 1.25 * s, smoke); col = mix(col, col * (0.6 + 0.8 * s), smoke); }
  fragColor = vec4(col, clamp(a * fade, 0.0, 1.0)); }
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet index='4 0 8 2 1 3 1 2 9 1 6 3 0 4 10 10 4 5 2 13 9 3 6 2 8 20 4 9 6 1 2 7 13 7 2 6 0 11 19 8 0 19 0 10 11 20 5 4 9 14 6 6 14 7 19 16 8 16 20 8 13 12 9 20 10 5 19 11 17 30 20 16 9 12 14 12 13 7 14 12 7 25 15 23 18 15 25 23 15 28 18 29 15 11 10 21 20 21 10 29 28 15 19 17 33 30 21 20 25 23 22 25 32 18 24 33 17 33 30 19 24 17 11 19 30 16 24 11 21 25 22 40 25 34 32 31 26 36 41 26 31 27 36 26 27 26 41 29 18 37 40 34 25 23 51 22 35 41 31 23 28 57 36 27 38 27 41 47 32 37 18 33 24 39 39 30 33 39 24 21 30 39 21 49 34 40 34 42 32 35 31 52 35 61 41 51 23 56 43 23 57 38 63 36 57 28 29 47 55 27 38 27 48 37 59 29 49 50 34 52 44 35 31 36 52 56 23 43 34 43 42 41 45 47 32 42 54 60 49 40 50 56 43 50 43 34 52 36 46 61 45 41 45 46 36 45 36 63 43 57 53 64 29 59 54 37 32 54 59 37 27 65 48 55 65 27 40 22 67 35 44 61 77 51 56 50 77 56 45 61 68 43 53 56 56 42 43 57 73 53 56 85 42 45 63 47 47 74 55 60 40 67 44 52 69 52 46 69 38 58 63 66 47 63 58 38 48 66 74 47 29 64 57 60 50 49 67 22 51 53 62 56 62 78 56 68 46 45 85 54 42 61 44 72 63 58 66 54 80 59 67 76 60 76 50 60 72 44 69 72 68 61 46 68 69 53 79 62 79 53 73 85 84 54 70 57 64 64 59 71 48 65 81 71 59 80 55 74 89 65 55 93 93 55 89 50 76 77 51 77 82 68 72 69 62 79 83 84 80 54 65 93 75 82 76 67 67 51 82 78 85 56 73 57 70 58 88 66 66 92 74 65 75 81 71 80 86 82 77 76 78 62 83 97 70 64 97 64 71 88 92 66 113 89 74 84 86 80 71 86 98 83 79 91 84 85 95 113 74 92 84 96 86 87 75 93 79 73 91 78 95 85 91 73 70 48 81 58 99 86 96 98 86 90 99 90 86 95 78 94 97 95 70 84 95 103 115 96 84 94 83 91 94 91 70 88 106 92 95 94 70 117 88 58 58 81 117 103 95 97 81 75 104 104 75 87 83 94 78 103 115 84 92 110 113 108 97 71 108 71 98 132 93 89 93 109 87 100 90 101 90 99 101 105 101 99 102 106 88 102 88 114 106 122 92 92 122 110 103 97 107 132 109 93 111 99 96 98 90 100 99 111 105 88 117 114 132 113 124 132 89 113 96 135 111 81 116 117 81 104 116 115 135 96 109 112 87 101 131 100 97 108 107 104 87 112 132 