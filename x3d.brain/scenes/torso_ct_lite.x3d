<Switch DEF='SW_BRAIN' whichChoice='0'><Group DEF='G_BRAIN'><Shape DEF='STRUCT_cortex_left'><Appearance DEF='APP_BRAIN'><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_BRAIN' language='GLSL'><field name='rimColor' type='SFColor' accessType='inputOutput' value='1.00 0.80 0.52'/><field name='bodyColor' type='SFColor' accessType='inputOutput' value='0.95 0.60 0.30'/><field name='rimPower' type='SFFloat' accessType='inputOutput' value='2.0'/><field name='baseAlpha' type='SFFloat' accessType='inputOutput' value='0.17'/><field name='rimAlpha' type='SFFloat' accessType='inputOutput' value='1.0'/><field name='useColor' type='SFFloat' accessType='initializeOnly' value='1'/><field name='smoke' type='SFFloat' accessType='inputOutput' value='0'/><field name='time' type='SFTime' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix; uniform float useColor;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out vec3 vO; out vec2 vC;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vO = x3d_Vertex.xyz;
  vN = normalize(x3d_NormalMatrix * x3d_Normal); vC = useColor > 0.5 ? x3d_Color.rg : vec2(1.0);
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 rimColor; uniform vec3 bodyColor; uniform float rimPower; uniform float baseAlpha; uniform float rimAlpha;
uniform float smoke; uniform float time;
in vec3 vN; in vec3 vP; in vec3 vO; in vec2 vC; out vec4 fragColor;
float hash(vec3 p){ p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float vnoise(vec3 x){ vec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x), mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
             mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x), mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y), f.z); }
void main(){ vec3 N = normalize(vN); vec3 V = normalize(-vP); float ndv = abs(dot(N, V));
  float f = pow(1.0 - ndv, rimPower);
  float ao = vC.x; float fade = vC.y;
  vec3 col = mix(bodyColor * ao, rimColor, f);
  float a = mix(baseAlpha, rimAlpha, f) * mix(1.4, 0.8, ao);
  if (smoke > 0.0) { vec3 q = vO * 0.016 + vec3(0.0, time * 0.035, time * 0.02);
    float n = 0.55 * vnoise(q) + 0.30 * vnoise(q * 2.3 + 7.1) + 0.15 * vnoise(q * 5.1 + 3.3);
    float s = smoothstep(0.30, 0.70, n);
    a *= mix(1.0, 0.2 + 1.25 * s, smoke); col = mix(col, col * (0.6 + 0.8 * s), smoke); }
  fragColor = vec4(col, clamp(a * fade, 0.0, 1.0)); }
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet DEF='GEO_cortex_left' index='149 147 1767 149 1767 148 149 148 1014 2535 660 787 154 155 2559 1404 791 1403 1696 1697 2231 1523 813 1822 808 2278 2436 2033 815 627 4 821 1846 87 1304 1850 1318 2983 1861 1015 1862 835 2742 856 855 609 553 608 668 2489 1502 401 242 2191 401 869 242 1918 1917 1054 1660 2519 1659 1346 2573 1946 2576 887 409 900 2624 901 910 2645 911 2239 917 916 1452 287 286 436 437 937 663 2008 1496 440 940 939 2553 444 2020 126 2799 2060 1593 963 1140 1593 2801 963 1838 2068 965 62 2860 2090 1848 2326 2100 354 2331 982 985 984 1168 2501 1701 1308 2340 2115 988 2340 2928 2115 990 2914 991 998 1732 999 31 1002 1001 2917 135 388 2534 2157 9 2651 679 1035 2607 1780 863 160 2177 1780 1741 1061 1060 1788 2202 1787 1069 1068 167 1201 2209 2386 2206 1071 2212 1796 414 1795 169 1077 415 2613 1959 2610 1802 2227 2226 1697 1087 1086 1222 800 912 1444 2240 425 1820 2270 1119 185 1130 1129 57 1134 1832 2824 337 2822 1846 2315 549 2334 2332 1850 197 1168 196 2342 2344 2343 2960 1175 1174 6 785 2139 833 2372 1194 2385 1199 1867 382 502 501 505 1219 2407 77 1221 1022 1875 913 1223 845 1225 801 2159 2413 1226 851 2434 2432 2449 1249 527 2451 1254 529 1897 1256 2456 538 818 537 1267 859 1137 1270 1283 1902 1904 549 236 1904 550 549 1646 191 1291 864 1160 1296 242 1308 2191 242 2501 1308 1913 2504 401 2509 2120 1916 276 2514 1735 1925 1315 1059 1926 1761 1316 93 1023 2199 1934 245 1935 1348 2020 250 99 1348 1347 581 580 1941 2572 2571 1358 1946 2573 1359 2575 2576 2574 595 2591 594 500 1377 2393 2605 2602 1391 2698 2609 655 2615 608 266 730 103 269 272 1405 1961 1407 1408 614 1967 2628 1414 2634 622 421 2234 2637 625 626 276 2639 1974 1428 911 277 2235 1975 175 2649 423 1982 635 634 2671 920 1450 1988 1449 637 1105 291 2251 1239 1480 1479 2714 1497 1496 2727 2728 218 446 2730 2729 2025 1516 2327 223 1546 2577 2773 2772 2039 2776 682 957 1555 686 2044 1570 1572 1571 593 2058 592 2059 1583 58 328 327 1586 1