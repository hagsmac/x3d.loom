></Shape><TouchSensor DEF='TS_BRAIN' description='Brain ghost: template cortex (fsaverage), cerebellum and brainstem, affinely fitted into this subject&apos;s brain mask. ILLUSTRATIVE: the folds are the template&apos;s, not the subject&apos;s'/></Group></Switch>
<Switch DEF='SW_BRAIN_CT' whichChoice='-1'><Group DEF='G_BRAIN_CT'><Shape DEF='STRUCT_brain'><Appearance DEF='APP_BRAINCT'><Material diffuseColor='0 0 0' transparency='0.01'/><ComposedShader DEF='SH_BRAINCT' language='GLSL'><field name='rimColor' type='SFColor' accessType='inputOutput' value='1.00 0.72 0.38'/><field name='bodyColor' type='SFColor' accessType='inputOutput' value='0.95 0.48 0.18'/><field name='rimPower' type='SFFloat' accessType='inputOutput' value='1.6'/><field name='baseAlpha' type='SFFloat' accessType='inputOutput' value='0.22'/><field name='rimAlpha' type='SFFloat' accessType='inputOutput' value='0.9'/><field name='useColor' type='SFFloat' accessType='initializeOnly' value='0'/><field name='smoke' type='SFFloat' accessType='inputOutput' value='0'/><field name='time' type='SFTime' accessType='inputOutput' value='0'/><ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix; uniform mat3 x3d_NormalMatrix; uniform float useColor;
in vec4 x3d_Vertex; in vec3 x3d_Normal; in vec4 x3d_Color;
out vec3 vN; out vec3 vP; out vec3 vO; out vec2 vC;
void main(){ vec4 p = x3d_ModelViewMatrix * x3d_Vertex; vP = p.xyz; vO = x3d_Vertex.xyz;
  vN = normalize(x3d_NormalMatrix * x3d_Normal); vC = useColor > 0.5 ? x3d_Color.rg : vec2(1.0);
  gl_Position = x3d_ProjectionMatrix * p; }
]]></ShaderPart><ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 rimColor; uniform vec3 bodyColor; uniform float rimPower; uniform float baseAlpha; uniform float rimAlpha;
uniform float smoke; uniform float time;
in vec3 vN; in vec3 vP; in vec3 vO; in vec2 vC; out vec4 fragColor;
float hash(vec3 p){ p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float vnoise(vec3 x){ vec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x), mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
             mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x), mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y), f.z); }
void main(){ vec3 N = normalize(vN); vec3 V = normalize(-vP); float ndv = abs(dot(N, V));
  float f = pow(1.0 - ndv, rimPower);
  float ao = vC.x; float fade = vC.y;
  vec3 col = mix(bodyColor * ao, rimColor, f);
  float a = mix(baseAlpha, rimAlpha, f) * mix(1.4, 0.8, ao);
  if (smoke > 0.0) { vec3 q = vO * 0.016 + vec3(0.0, time * 0.035, time * 0.02);
    float n = 0.55 * vnoise(q) + 0.30 * vnoise(q * 2.3 + 7.1) + 0.15 * vnoise(q * 5.1 + 3.3);
    float s = smoothstep(0.30, 0.70, n);
    a *= mix(1.0, 0.2 + 1.25 * s, smoke); col = mix(col, col * (0.6 + 0.8 * s), smoke); }
  fragColor = vec4(col, clamp(a * fade, 0.0, 1.0)); }
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet index='0 23 1 1 2 0 16 0 2 3 6 18 4 16 2 7 2 1 10 4 2 10 2 7 18 5 3 5 18 8 13 23 0 24 7 1 9 14 3 6 3 14 8 18 33 4 34 16 34 4 19 4 10 19 9 10 7 3 5 9 12 10 9 5 12 9 19 10 11 12 11 10 5 20 12 8 20 5 0 39 13 14 15 6 25 15 14 16 39 0 14 17 25 15 18 6 14 9 17 9 7 24 17 9 24 8 29 28 19 11 21 8 28 20 12 22 11 22 12 20 23 25 24 24 1 23 25 17 24 15 32 18 16 26 39 18 32 33 16 34 26 33 43 8 29 8 43 27 34 19 21 27 19 21 11 30 11 22 30 20 40 22 23 31 41 23 41 38 31 23 13 23 38 25 34 27 51 21 30 27 28 40 20 40 37 22 13 60 31 41 31 46 15 25 38 15 47 32 39 26 35 32 49 33 33 49 43 40 28 29 22 36 30 36 22 37 63 37 40 15 38 47 55 32 47 43 57 29 29 58 40 37 45 36 60 46 31 38 41 42 38 42 47 55 49 32 26 34 66 61 57 43 29 57 58 27 30 44 45 52 36 63 45 37 41 46 54 59 46 60 13 48 60 39 48 13 35 26 50 49 61 43 27 44 51 40 58 63 64 44 30 30 36 64 36 52 64 45 53 52 59 54 46 47 42 68 55 47 68 39 35 48 105 49 55 50 26 56 26 66 56 51 66 34 71 45 63 45 71 53 59 67 54 41 54 42 65 59 60 49 75 61 61 62 57 67 68 54 68 42 54 60 48 65 55 68 104 35 50 48 105 75 49 62 91 57 51 44 70 71 63 58 53 64 52 71 82 53 48 69 65 87 55 104 87 105 55 48 50 69 50 56 69 75 76 61 61 76 62 51 70 66 57 91 58 64 72 44 64 73 72 64 53 73 73 53 74 74 53 82 71 93 82 59 65 168 168 67 59 68 67 133 68 133 104 69 56 77 77 56 79 56 66 79 62 76 78 66 70 79 80 70 44 81 80 44 81 44 72 58 93 71 96 83 95 96 99 83 83 100 95 100 84 95 99 100 83 65 85 168 133 67 200 85 69 86 85 65 69 86 69 88 69 77 88 77 89 88 75 105 106 77 90 89 75 106 76 106 113 76 77 79 90 76 113 78 70 92 79 62 78 91 70 80 92 93 58 91 73 74 148 74 82 119 119 82 118 121 120 95 120 94 96 96 95 120 180 96 94 180 98 96 96 98 99 95 84 121 98 123 99 99 159 100 159 99 123 84 100 101 100 102 101 159 102 100 67 168 199 67 199 200 130 88 103 85 86 131 103 88 129 86 88 130 87 104 136 88 89 129 87 136 105 135 108 107 170 137 135 137 108 135 129 89 111 107 109 106 108 110 107 137 110 108 89 112 111 107 110 109 137 138 