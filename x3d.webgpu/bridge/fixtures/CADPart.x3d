<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="CADGeometry" level="2"/><meta name="title" content="CADPart.x3d"/><meta name="description" content="Bridge fixture for the CAD product structure (CADAssembly, CADLayer, CADPart, CADFace): a part moved by its Transform fields, a nested assembly, a hidden layer that is shown by an event"/></head>
  <Scene>
    <Viewpoint position="0 0 12"/>
    <CADAssembly DEF="A" name="engine">
      <CADLayer DEF="L1" name="body">
        <CADPart DEF="P1" name="block" translation="-3 0.5 0" rotation="0 0 1 0.5" scale="1 1.5 1">
          <CADFace DEF="F1" name="top"><Shape containerField="shape"><Appearance><Material diffuseColor="0.9 0.25 0.2"/></Appearance><Box size="2 1 1"/></Shape></CADFace>
        </CADPart>
        <CADAssembly DEF="A2" name="sub">
          <CADPart DEF="P2" name="ball" translation="3 0 0">
            <CADFace DEF="F2" name="sphere"><Shape containerField="shape"><Appearance><Material diffuseColor="0.2 0.6 0.9"/></Appearance><Sphere radius="1.1"/></Shape></CADFace>
          </CADPart>
        </CADAssembly>
      </CADLayer>
      <CADLayer DEF="L2" name="hidden" visible="false">
        <CADPart DEF="P3" name="cone" translation="0 -2.4 0">
          <CADFace DEF="F3" name="cone"><Shape containerField="shape"><Appearance><Material diffuseColor="0.3 0.85 0.3"/></Appearance><Cone bottomRadius="1" height="1.6"/></Shape></CADFace>
        </CADPart>
      </CADLayer>
    </CADAssembly>
  </Scene>
</X3D>
