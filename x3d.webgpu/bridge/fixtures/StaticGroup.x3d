<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="StaticGroup.x3d"/><meta name="description" content="Bridge fixture for StaticGroup"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Group>
      <StaticGroup DEF="SG">
        <Transform translation="-2 0 0"><Shape DEF="S1"><Appearance><Material diffuseColor="0.2 0.7 0.9"/></Appearance><Box size="2 2 2"/></Shape></Transform>
        <Transform translation="2 0 0"><Shape DEF="S2"><Appearance><Material diffuseColor="0.2 0.7 0.9"/></Appearance><Sphere radius="1"/></Shape></Transform>
      </StaticGroup>
      <TouchSensor DEF="TS"/>
    </Group>
    <StaticGroup DEF="SG2" visible="false">
      <Transform translation="0 -2.5 0"><Shape><Appearance><Material diffuseColor="0.9 0.6 0.1"/></Appearance><Cone bottomRadius="0.9" height="1.5"/></Shape></Transform>
      <Transform translation="0 2.6 0" rotation="1 0 0 0.6"><Shape><Appearance><Material diffuseColor="0.8 0.3 0.6"/></Appearance><Cylinder radius="0.7" height="1.2"/></Shape></Transform>
    </StaticGroup>
  </Scene>
</X3D>
