<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Texturing3D" level="2"/><meta name="title" content="ImageTexture3D.x3d"/><meta name="description" content="Bridge fixture for ImageTexture3D: the same 8 x 8 x 8 colour gradient as an NRRD file (left) and a DDS volume (right), read by 3D texture coordinates (axial slice at r = 0.3)"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <Transform translation="-2.1 0 0"><Shape><Appearance><ImageTexture3D DEF="NR" url='"data:application/octet-stream;base64,"'/></Appearance><IndexedFaceSet coordIndex="0 1 2 3 -1"><Coordinate point="-1.5 -1.1 0, 1.5 -1.1 0, 1.5 1.1 0, -1.5 1.1 0"/><TextureCoordinate3D point="0 0 0.3, 1 0 0.3, 1 1 0.3, 0 1 0.3"/></IndexedFaceSet></Shape></Transform>
    <Transform translation="2.1 0 0"><Shape><Appearance><ImageTexture3D DEF="DD" url='"data:application/octet-stream;base64,"'/></Appearance><IndexedFaceSet coordIndex="0 1 2 3 -1"><Coordinate point="-1.5 -1.1 0, 1.5 -1.1 0, 1.5 1.1 0, -1.5 1.1 0"/><TextureCoordinate3D point="0 0 0.3, 1 0 0.3, 1 1 0.3, 0 1 0.3"/></IndexedFaceSet></Shape></Transform>
  </Scene>
</X3D>
