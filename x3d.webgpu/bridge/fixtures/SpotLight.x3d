<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Lighting" level="2"/><meta name="title" content="SpotLight.x3d"/><meta name="description" content="Bridge fixture for SpotLight: a spot from the front lights a disc on a wall, beyond cutOffAngle it is dark"/></head>
  <Scene>
    <NavigationInfo headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <SpotLight DEF="L" location="0 0 6" direction="0 0 -1" beamWidth="0.3" cutOffAngle="0.5" radius="30" intensity="1.5"/>
    <Shape><Appearance><Material diffuseColor="0.9 0.9 0.9"/></Appearance><Box size="14 9 0.2"/></Shape>
  </Scene>
</X3D>
